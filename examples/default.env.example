# Shared defaults for the original single-wallet setup.
AWP_PREDICT_PROJECT_DIR=/srv/awp-predict
AWP_PREDICT_OPENCLAW_HOME=/srv/awp-predict
AWP_WALLET_BIN=/srv/awp-miner/vendor/node/bin/awp-wallet
AWP_WALLET_HOME=/srv/awp-miner/.wallet
AWP_AGENT_ID=awp-miner
PREDICT_SERVER_URL=https://api.agentpredict.work
OPENAI_BASE_URL=https://cdk.muyuai.top/v1
OPENAI_MODEL=gpt-5.4
PREDICT_LOOP_INTERVAL=120
AWP_PREDICT_GATEWAY_SERVICE=awp-predict-gateway
AWP_PREDICT_LOOP_SERVICE=awp-predict-loop
AWP_PREDICT_MONITOR_SERVICE=awp-predict-monitor
AWP_PREDICT_LOOP_JOURNAL_UNIT=awp-predict-loop
AWP_PREDICT_INSTANCE_NAME=awp-predict
AWP_PREDICT_MONITOR_HOST=127.0.0.1
AWP_PREDICT_MONITOR_PORT=8791
