# Example for a second wallet instance using the shared gateway.
AWP_PREDICT_PROJECT_DIR=/srv/awp-predict
AWP_PREDICT_OPENCLAW_HOME=/srv/awp-predict
AWP_WALLET_BIN=/srv/awp-miner/vendor/node/bin/awp-wallet
AWP_WALLET_HOME=/srv/awp-wallets/wallet02/.wallet
AWP_AGENT_ID=awp-wallet02
PREDICT_SERVER_URL=https://api.agentpredict.work
OPENAI_BASE_URL=https://cdk.muyuai.top/v1
OPENAI_MODEL=gpt-5.4
PREDICT_LOOP_INTERVAL=120
AWP_PREDICT_GATEWAY_SERVICE=awp-predict-gateway
AWP_PREDICT_LOOP_SERVICE=awp-predict-loop@wallet02
AWP_PREDICT_MONITOR_SERVICE=awp-predict-monitor@wallet02
AWP_PREDICT_LOOP_JOURNAL_UNIT=awp-predict-loop@wallet02
AWP_PREDICT_INSTANCE_NAME=wallet02
AWP_PREDICT_MONITOR_HOST=127.0.0.1
AWP_PREDICT_MONITOR_PORT=8792
